    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-powerline-footer",
    "npm:glimpseui",
    "npm:pi-intercom",
    "npm:@ff-labs/pi-fff",
